
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ayan Star | Welcome</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  color: #fff;
  font-family: Arial, sans-serif;
  overflow-x: hidden;
  background: radial-gradient(ellipse at top, #202b40, #080b12 65%);
  transition: background 0.8s;
}

body.on {
  background: radial-gradient(ellipse at top, #65451d, #100f12 70%);
}

/* LAMP */
.lamp-area {
  height: 300px;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wire {
  width: 3px;
  height: 85px;
  background: #aaa;
}

.lamp {
  width: 110px;
  height: 60px;
  position: relative;
  border-radius: 60px 60px 12px 12px;
  background: linear-gradient(135deg, #525765, #171a22);
  border-bottom: 7px solid #08090d;
  box-shadow: 0 8px 20px #0008;
}

.bulb {
  position: absolute;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  left: 37px;
  bottom: -27px;
  background: #777;
  transition: 0.5s;
}

body.on .bulb {
  background: #fff0a6;
  box-shadow: 0 0 25px 12px #ffce58,
              0 0 80px 40px #ffb52e88;
}

.light-beam {
  position: absolute;
  top: 145px;
  border-left: 170px solid transparent;
  border-right: 170px solid transparent;
  border-top: 290px solid #ffcc5820;
  opacity: 0;
  pointer-events: none;
  transition: 0.5s;
}

body.on .light-beam {
  opacity: 1;
}

.pull-cord {
  position: absolute;
  top: 145px;
  left: calc(50% + 42px);
  width: 4px;
  height: 70px;
  background: #e4c47b;
  cursor: grab;
  touch-action: none;
  z-index: 10;
}

.pull-cord::after {
  content: "";
  position: absolute;
  left: -7px;
  bottom: -10px;
  width: 18px;
  height: 23px;
  border-radius: 7px;
  background: linear-gradient(135deg, #ffe6a4, #b57a20);
}

.hint {
  position: absolute;
  top: 245px;
  font-size: 12px;
  color: #d0d0d0;
  letter-spacing: 1.5px;
  text-align: center;
}

/* WELCOME CARD */
.welcome-page {
  width: 92%;
  max-width: 650px;
  margin: 0 auto 35px;
  padding: 32px 22px;
  text-align: center;
  border: 1px solid #ffffff20;
  border-radius: 24px;
  background: #151a27eF;
  box-shadow: 0 20px 60px #0008;
  backdrop-filter: blur(12px);

  opacity: 0;
  visibility: hidden;
  transform: translateY(35px);
  pointer-events: none;
  transition: opacity 0.6s, transform 0.6s, visibility 0.6s;
}

body.on .welcome-page {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.avatar {
  width: 95px;
  height: 95px;
  margin: 0 auto 18px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff0a6, #f2a51c);
  color: #111;
  border: 4px solid #fff;
  font-size: 30px;
  font-weight: bold;
  box-shadow: 0 0 25px #ffc85766;
}

.tag {
  color: #ffc857;
  font-size: 12px;
  letter-spacing: 4px;
  margin-bottom: 12px;
}

h1 {
  font-size: clamp(32px, 8vw, 50px);
  margin-bottom: 14px;
}

h1 span {
  color: #ffc857;
}

.description {
  color: #c5cad5;
  line-height: 1.8;
  font-size: 15px;
  margin: 0 auto 25px;
}

.social-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
}

.social-button {
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 13px;
  padding: 14px 8px;
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  font-weight: bold;
  transition: transform 0.2s;
}

.social-button:active {
  transform: scale(0.97);
}

.facebook {
  background: #1877f2;
}

.tiktok {
  background: #101010;
  border: 1px solid #555;
}

.social-icon {
  font-size: 23px;
}

.footer {
  margin-top: 27px;
  color: #8f96a6;
  font-size: 11px;
  letter-spacing: 2px;
}

@media (max-width: 420px) {
  .social-links {
    grid-template-columns: 1fr;
  }

  .welcome-page {
    padding: 28px 17px;
  }
}
</style>
</head>

<body>

<div class="lamp-area">
  <div class="light-beam"></div>
  <div class="wire"></div>

  <div class="lamp">
    <div class="bulb"></div>
  </div>

  <div class="pull-cord" id="pullCord"></div>
  <div class="hint" id="hint">PULL THE CORD TO START</div>
</div>

<main class="welcome-page">
  <div class="avatar">AS</div>

  <div class="tag">WELCOME TO MY WORLD</div>

  <h1>I'm <span>Ayan Star</span></h1>

  <p class="description">
    Welcome to my profile! ✨<br>
    Follow me on social media and stay connected.
  </p>

  <div class="social-links">

    <a class="social-button facebook"
       href="https://www.facebook.com/share/1EuDJpJ4T7/"
       target="_blank"
       rel="noopener noreferrer">
      <span class="social-icon">f</span>
      Facebook Profile
    </a>

    <a class="social-button tiktok"
       href="https://www.tiktok.com/@itz_ayan2.0"
       target="_blank"
       rel="noopener noreferrer">
      <span class="social-icon">♪</span>
      TikTok Profile
    </a>

  </div>

  <div class="footer">DESIGNED WITH ♥ BY AYAN STAR</div>
</main>

<script>
const cord = document.getElementById("pullCord");
const hint = document.getElementById("hint");

let dragging = false;
let startY = 0;
let distance = 0;

function toggleLamp() {
  document.body.classList.toggle("on");

  hint.textContent = document.body.classList.contains("on")
    ? "PULL AGAIN TO TURN OFF"
    : "PULL THE CORD TO START";
}

cord.addEventListener("pointerdown", function(e) {
  dragging = true;
  startY = e.clientY;
  distance = 0;
  cord.setPointerCapture(e.pointerId);
});

cord.addEventListener("pointermove", function(e) {
  if (!dragging) return;

  distance = Math.max(0, e.clientY - startY);
  cord.style.height = (70 + Math.min(distance, 80)) + "px";
});

function endPull() {
  if (!dragging) return;

  dragging = false;
  cord.style.height = "70px";

  if (distance > 25) {
    toggleLamp();
  }

  distance = 0;
}

cord.addEventListener("pointerup", endPull);
cord.addEventListener("pointercancel", endPull);

/*
  External profile links use HTTPS.
  This fallback attempts to open links in a new tab
  if the WebView does not handle target="_blank".
*/
document.querySelectorAll(".social-button").forEach(function(link) {
  link.addEventListener("click", function(e) {
    e.preventDefault();

    const url = link.href;

    const newWindow = window.open(url, "_blank");

    if (!newWindow) {
      window.location.href = url;
    }
  });
});
</script>

</body>
</html>
